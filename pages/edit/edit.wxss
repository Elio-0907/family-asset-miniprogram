.chips { display: flex; flex-wrap: wrap; padding: 28rpx 40rpx 0; }
.chips.small .chip { font-size: 23rpx; }
.chip { padding: 14rpx 24rpx; margin: 0 14rpx 14rpx 0; border-radius: 999rpx;
        border: none; font-size: 25rpx;
        background: var(--card); color: var(--text-2); }
.chip.on { background: var(--tint); color: #FFFFFF; border-color: var(--tint); }

.hint { margin: 20rpx 40rpx 0; padding: 0 8rpx;
        font-size: 24rpx; line-height: 1.65; color: var(--text-2); }

.form { margin: 28rpx 40rpx 0; background: var(--card); border-radius: 24rpx; padding: 0 28rpx; }
.field { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid var(--hair); }
.form > .field:last-child { border-bottom: none; }
.fl { font-size: 26rpx; color: var(--text-2); width: 170rpx; flex: none; }
.fi { flex: 1; min-width: 0; font-size: 28rpx; color: var(--text); text-align: right;
      font-variant-numeric: tabular-nums; }
.fi.auto { color: var(--text-3); }
.ph { color: var(--text-3); }
.fu { font-size: 24rpx; color: var(--text-3); margin-left: 14rpx; flex: none; }
.autotag { font-size: 19rpx; padding: 4rpx 10rpx; border-radius: 8rpx;
           background: var(--surface-2); color: var(--text-3); margin-left: 14rpx; flex: none; }

.calcbox { margin: 24rpx 40rpx 0; padding: 26rpx 28rpx; border-radius: 24rpx; background: var(--card); }
.cline { display: flex; justify-content: space-between; align-items: baseline;
         font-size: 25rpx; color: var(--text-2); padding: 9rpx 0; }
.cv { font-size: 27rpx; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }

.truth { margin: 24rpx 40rpx 0; padding: 24rpx 28rpx; border-radius: 24rpx;
         background: var(--card); display: flex; }
.truth .stripe { width: 6rpx; border-radius: 4rpx; background: var(--seal);
                 margin-right: 20rpx; flex: none; }
.ttext { font-size: 25rpx; line-height: 1.65; color: var(--text); }

.btn.mt { margin-top: 20rpx; }

/* picker 默认是 inline，不占 flex 空间，里面的值就靠左了；让它撑满 */
.field picker { flex: 1; min-width: 0; }
.field:last-child { border-bottom: none; }
.field picker .fi { text-align: right; }

/* 持仓编辑器 */
.hold { padding: 30rpx 0 24rpx; border-bottom: 1rpx solid var(--hair); }
.hold-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14rpx; }
.hold-tip { font-size: 21rpx; color: var(--text-3); }
.hrow { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--hair); }
.hcode { width: 150rpx; flex: none; font-size: 27rpx; font-variant-numeric: tabular-nums;
         padding: 10rpx 14rpx; border-radius: 10rpx; background: var(--surface-2); }
.hname { flex: 1; min-width: 0; padding: 0 16rpx; }
.hn { display: block; font-size: 25rpx; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hn.bad { color: var(--seal); }
.hp { display: block; font-size: 21rpx; color: var(--text-3); margin-top: 2rpx; font-variant-numeric: tabular-nums; }
.hshares { width: 150rpx; flex: none; font-size: 27rpx; text-align: right; font-variant-numeric: tabular-nums;
           padding: 10rpx 14rpx; border-radius: 10rpx; background: var(--surface-2); }
.hdel { width: 48rpx; text-align: center; color: var(--text-3); font-size: 34rpx; flex: none; margin-left: 6rpx; }
.addhold { margin-top: 16rpx; padding: 18rpx; border-radius: 14rpx; background: var(--tint-soft);
           text-align: center; font-size: 25rpx; color: var(--tint); font-weight: 500; }
.hold-sum { margin-top: 18rpx; font-size: 24rpx; color: var(--text-2); text-align: right; }
.hold-sum .v { font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.hold-fx { font-size: 21rpx; color: var(--text-3); }

/* 从截图更新 */
.shot { padding: 26rpx 0 6rpx; border-bottom: 1rpx solid var(--hair); }
.hold-shot { margin-bottom: 16rpx; }
.shotbtn { display: flex; align-items: center; padding: 22rpx 24rpx; border-radius: 18rpx;
           background: var(--tint-soft); }
.shotbtn.compact { padding: 18rpx 22rpx; }
.shoticon { font-size: 40rpx; color: var(--brass); margin-right: 20rpx; flex: none; }
.shott { font-size: 27rpx; font-weight: 500; color: var(--text); }
.shots { font-size: 22rpx; color: var(--text-2); margin-top: 4rpx; line-height: 1.5; }
.ocrbox { margin-top: 16rpx; padding: 22rpx 24rpx; border-radius: 18rpx;
          background: var(--surface-2); }
.ocrsub { font-size: 22rpx; color: var(--text-2); margin: 10rpx 0 12rpx; }
.ocropts { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 8rpx; }
.ocropt { display: flex; justify-content: space-between; align-items: baseline;
          padding: 16rpx 20rpx; border-radius: 14rpx; background: var(--card);
          border: 2rpx solid transparent; }
.ocropt.on { border-color: var(--tint); background: var(--tint-soft); }
.ocropt-l { font-size: 25rpx; color: var(--text-2); }
.ocropt.on .ocropt-l { color: var(--tint); font-weight: 600; }
.ocropt-v { font-size: 27rpx; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.ocrholds { margin-top: 12rpx; padding-top: 10rpx; border-top: 1rpx solid var(--hair); }
.ocrh { display: flex; align-items: baseline; padding: 8rpx 0; font-size: 24rpx; }
.ocrh-n { flex: 1; min-width: 0; color: var(--text); font-weight: 500;
          white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ocrh-c { font-size: 22rpx; color: var(--text-3); margin: 0 16rpx; font-variant-numeric: tabular-nums; }
.ocrh-s { font-size: 24rpx; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.ocrnote { font-size: 21rpx; color: var(--text-3); margin-top: 10rpx; }
.btnrow { display: flex; margin-top: 20rpx; }
.btn.half { flex: 1; margin-right: 14rpx; padding: 22rpx; font-size: 26rpx; }
.btn.half:last-child { margin-right: 0; }

/* 更新方式二选一 */
.umode { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid var(--hair); }
.seg2 { display: flex; margin-left: auto; padding: 4rpx; border-radius: 14rpx; background: var(--surface-2); }
.seg2i { padding: 10rpx 26rpx; border-radius: 11rpx; font-size: 24rpx; color: var(--text-2); }
.seg2i.on { background: var(--card); color: var(--text); font-weight: 600;
            box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.08); }

.fromplan { margin: 20rpx 40rpx 0; padding: 20rpx 24rpx; border-radius: 18rpx; background: var(--tint-soft);
            font-size: 23rpx; line-height: 1.6; color: var(--text-2); display: flex; align-items: center; }
.fromplan .chev { margin-left: 12rpx; color: var(--tint); }

/* 期数调节器 */
.stepbox { display: flex; align-items: center; padding: 26rpx 28rpx; border-radius: 24rpx; background: var(--card); }
.stepbox .b { flex: 1; min-width: 0; }
.stepbox .t { font-size: 27rpx; font-weight: 500; }
.stepbox .s { font-size: 21rpx; color: var(--text-3); margin-top: 4rpx; line-height: 1.5; }
.stepper { display: flex; align-items: center; margin-left: 20rpx; }
.stb { width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--tint-soft); color: var(--tint);
       display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 600; }
.stn { min-width: 70rpx; text-align: center; font-size: 32rpx; font-weight: 600; font-variant-numeric: tabular-nums; }

/* 每月存单总览卡与折叠列表 */
.plan-hero { padding: 34rpx 30rpx; border-radius: 26rpx; background: var(--head-bg); color: var(--head-text); }
.plan-hero .eyebrow { color: var(--head-dim); }
.plan-tot { font-size: 60rpx; font-weight: 700; margin-top: 12rpx; font-variant-numeric: tabular-nums; }
.plan-rule { font-size: 24rpx; color: var(--head-text); opacity: 0.9; margin-top: 16rpx; line-height: 1.5; }
.plan-meta { font-size: 22rpx; color: var(--head-dim); margin-top: 10rpx; }
.layer.open { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.rows.inlayer { border-top-left-radius: 0; border-top-right-radius: 0; border-top: 1rpx solid var(--hair); }
.chev.down { transform: rotate(90deg); }
.layer .chev { transition: transform .15s ease; }
