/* 到期页：iOS 分组卡片风，两张纯布局画的图 */
page { --card: #FFFFFF; --hair: #ECEDE8; --tint: #B89A5E; --tint-soft: #EBDFC3; --tint-deep: #9A7B41;
       --grey-bar: #D5DAD3; --grey-deep: #A9B2AC; }
@media (prefers-color-scheme: dark) {
  page { --card: #1A211D; --hair: #2B3430; --tint: #C6A464; --tint-soft: #4A3F26; --tint-deep: #E0C283;
         --grey-bar: #3A433E; --grey-deep: #6E7873; }
}

.card { margin: 24rpx 40rpx 0; padding: 26rpx 28rpx 22rpx; background: var(--card); border-radius: 24rpx; }
.card-h { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 22rpx; }
.lg { display: flex; align-items: center; font-size: 21rpx; color: var(--text-3); }
.lgd { width: 14rpx; height: 14rpx; border-radius: 4rpx; margin: 0 8rpx 0 16rpx; }
.lgt { font-size: 21rpx; color: var(--text-3); }
.t-cd { background: var(--tint-soft); }
.t-rc { background: var(--grey-bar); }

/* A. 半年柱状图 */
.bars { display: flex; align-items: flex-end; height: 300rpx; }
.bk { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.bkv { font-size: 20rpx; color: var(--text-2); font-variant-numeric: tabular-nums; height: 32rpx; line-height: 32rpx; }
.bkcol { flex: 1; width: 60%; display: flex; flex-direction: column-reverse; }
.seg { width: 100%; border-radius: 6rpx 6rpx 0 0; }
.seg + .seg { border-radius: 6rpx 6rpx 0 0; }
.seg.t-cd.hot { background: var(--tint); }
.bkl { font-size: 20rpx; color: var(--text-3); margin-top: 12rpx; height: 28rpx; }
.bkl.now { color: var(--text); font-weight: 600; }

/* B. 梯子 */
.ld { display: flex; align-items: center; padding: 14rpx 0; }
.ldl { width: 190rpx; flex: none; padding-right: 16rpx; }
.ldn { font-size: 24rpx; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lds { font-size: 20rpx; color: var(--text-3); margin-top: 2rpx; font-variant-numeric: tabular-nums; }
.ldt { flex: 1; position: relative; height: 22rpx; background: var(--hair); border-radius: 11rpx; overflow: visible; }
.ldbar { position: absolute; top: 0; height: 100%; border-radius: 11rpx; background: var(--tint-soft); overflow: hidden; }
.ldbar.rc { background: var(--grey-bar); }
.lddone { height: 100%; background: var(--tint-deep); border-radius: 11rpx 0 0 11rpx; }
.ldbar.rc .lddone { background: var(--grey-deep); }
.ldnow { position: absolute; top: -8rpx; bottom: -8rpx; width: 2rpx; background: var(--text); opacity: 0.55; }
.ldaxis { position: relative; height: 40rpx; margin-left: 190rpx; margin-top: 8rpx; }
.ldtick { position: absolute; top: 0; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; }
.ldtl { width: 1rpx; height: 10rpx; background: var(--text-3); }
.ldtt { font-size: 20rpx; color: var(--text-3); margin-top: 4rpx; white-space: nowrap; }
.ldtt.now { color: var(--text); font-weight: 600; }

.insight { margin: 24rpx 40rpx 0; padding: 24rpx 26rpx; border-radius: 22rpx;
           background: var(--tint-soft); display: flex; }
.insight .stripe { width: 6rpx; border-radius: 4rpx; background: var(--tint-deep); margin-right: 20rpx; flex: none; }
.itext { font-size: 25rpx; line-height: 1.6; color: var(--text); }

.tl-y { display: flex; align-items: center; padding: 36rpx 40rpx 16rpx; }
.tl-y .hr { flex: 1; height: 1rpx; background: var(--line); margin-left: 20rpx; }

/* 每月开单计划 */
.pl { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--hair); }
.pl:last-child { border-bottom: none; }
.plb { flex: 1; min-width: 0; }
.plt { font-size: 26rpx; font-weight: 500; }
.pls { font-size: 22rpx; color: var(--text-2); margin-top: 4rpx; font-variant-numeric: tabular-nums; }

/* 梯子上的到期刻度 */
.ldnotch { position: absolute; top: -4rpx; bottom: -4rpx; width: 2rpx; background: var(--card); opacity: 0.9; }
/* 列表里合并行展开的子行 */
.row.sub { padding-left: 30rpx; }
.row.sub .t { font-size: 25rpx; font-weight: 400; color: var(--text-2); }
.chev.open { transform: rotate(90deg); }
