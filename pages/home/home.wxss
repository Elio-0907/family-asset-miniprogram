.eye { font-size: 22rpx; padding: 0 16rpx; width: auto; min-width: 64rpx; }

/* 自定义背景：照片铺满，上面盖一层深色渐变，白字不受照片明暗影响 */
.head { position: relative; overflow: hidden; }
.head-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.head-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%;
              background: linear-gradient(180deg, rgba(20,28,24,0.45) 0%, rgba(20,28,24,0.72) 60%, rgba(20,28,24,0.86) 100%); }
.head-in { position: relative; z-index: 1; }
.head-btns { display: flex; }
.head-btns .eye { margin-left: 12rpx; }
.head.has-bg .eye { background: rgba(0,0,0,0.25); border-color: rgba(255,255,255,0.18); color: #E5E9E2; }
.head.has-bg .eyebrow, .head.has-bg .head-sub { color: #C9D0CB; }
.head.has-bg .legend { color: #C9D0CB; }

/* 可动用明细：折叠行 + 展开后的列表接在下面 */
.layer.open { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.rows.inlayer { border-top-left-radius: 0; border-top-right-radius: 0; border-top: 1rpx solid var(--hair); }
.chev.down { transform: rotate(90deg); }
.layer .chev { transition: transform .15s ease; }

/* 大数字可点：切换可动用 / 净资产 */
.total { display: flex; align-items: baseline; }
.total .swap { font-size: 26rpx; color: var(--head-dim); margin-left: 16rpx; font-weight: 400; }
.head-hover { opacity: 0.7; }

.goalrow .goalpct { color: var(--tint); }
.ckpill { font-size: 22rpx; font-weight: 600; padding: 8rpx 18rpx; border-radius: 999rpx;
          background: var(--tint-soft); color: var(--tint-deep); flex: none; margin-left: 14rpx; }
.ckpill.done { background: var(--surface-2); color: var(--text-2); font-weight: 500; }

/* 首页顶部墨块内的目标配比一行提示 */
.alloc-bar { margin-top: 22rpx; padding: 16rpx 20rpx; border-radius: 16rpx;
             background: rgba(255,255,255,0.06); display: flex; align-items: center;
             font-size: 23rpx; color: var(--head-dim); }
.alloc-bar.warn { background: rgba(210,175,87,0.16); color: #E8C97A; }
.alloc-bar.alert { background: rgba(216,96,74,0.20); color: #F29785; }
.alloc-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 12rpx; flex: none;
             background: currentColor; }
.alloc-txt { flex: 1; min-width: 0; font-weight: 500; }
.alloc-go { margin-left: 12rpx; flex: none; opacity: 0.85; }

/* 首页紧凑分组间距 */
.sec.tight { padding-top: 24rpx; }
.sec.tight > .layer:first-child { margin-top: 0; }
.networth.insec { margin: 0; }

/* 生物解锁全屏遮罩 */
.lock-screen { position: fixed; inset: 0; z-index: 999; background: var(--bg);
               display: flex; align-items: center; justify-content: center; padding: 60rpx; }
.lock-box { width: 100%; padding: 64rpx 44rpx; border-radius: 32rpx; background: var(--card);
            text-align: center; }
.lock-badge { display: inline-block; padding: 14rpx 30rpx; border-radius: 18rpx;
              background: var(--head-bg); color: var(--head-text);
              font-size: 32rpx; font-weight: 700; letter-spacing: 0.12em; }
.lock-title { font-size: 36rpx; font-weight: 700; color: var(--text); margin-top: 36rpx; }
.lock-sub { font-size: 25rpx; color: var(--text-2); margin-top: 12rpx; }
.lock-btn { margin-top: 48rpx; }

/* 空账本引导 */
.onboard { padding: 40rpx 28rpx 28rpx; border-radius: 24rpx; background: var(--card); }
.ob-t { font-size: 32rpx; font-weight: 600; }
.ob-s { font-size: 24rpx; color: var(--text-3); margin: 8rpx 0 24rpx; }
.ob-btn { padding: 24rpx 26rpx; border-radius: 18rpx; background: var(--surface-2); margin-top: 14rpx; }
.ob-btn.primary { background: var(--tint-soft); }
.ob-bt { font-size: 28rpx; font-weight: 600; }
.ob-btn.primary .ob-bt { color: var(--tint-deep); }
.ob-bs { font-size: 23rpx; color: var(--text-2); margin-top: 6rpx; }
