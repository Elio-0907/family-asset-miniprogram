<view class="page" wx:if="{{me}}">
  <view class="pagetop">
    <view class="pagetitle">家庭账本</view>
    <view class="pagesub">同一个家庭的人看到同一份账本，都能录、都能改</view>
  </view>

  <!-- 通过分享卡片进来的：先把加入放最上面 -->
  <view class="sec joinfirst" wx:if="{{fromCard}}">
    <view class="joincard">
      <view class="jt">有人邀请你加入家庭账本</view>
      <view class="js">邀请码 <text class="mono">{{joinCode}}</text> · 填个称呼就能加入</view>
      <view class="field">
        <text class="fl">你的称呼</text>
        <input class="fi" value="{{joinName}}" placeholder="老婆 / 老公 / 名字" placeholder-class="ph" bindinput="onJoinName" />
      </view>
      <view class="btn mt" bindtap="onJoin" hover-class="btn-hover">加入</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-head"><text class="eyebrow">成员 · {{me.memberCount}} 人</text></view>
    <view class="rows">
      <view class="row" wx:for="{{me.members}}" wx:key="index"
            data-i="{{index}}" bindlongpress="onRemove">
        <view class="swatch tone-{{item.isOwner ? 1 : 3}}"></view>
        <view class="b">
          <view class="t">{{item.name}}<text class="mecap" wx:if="{{item.isMe}}">（我）</text></view>
          <view class="s">{{item.isOwner ? '创建者' : '成员'}}</view>
        </view>
        <text class="link" wx:if="{{item.isMe}}" bindtap="onRename">改称呼</text>
      </view>
    </view>
    <view class="hintline" wx:if="{{me.isOwner && me.memberCount > 1}}">长按成员可以移除</view>
  </view>

  <view class="sec">
    <view class="sec-head"><text class="eyebrow">邀请家人</text></view>
    <view class="invbox">
      <block wx:if="{{me.inviteCode}}">
        <view class="code">{{me.inviteCode}}</view>
        <view class="codes">24 小时内有效 · 家人在这一页输入，或者直接点下面发给他</view>
        <button class="btn sharebtn" open-type="share" hover-class="btn-hover">发送给家人</button>
        <view class="link center" bindtap="onInvite">换一个邀请码</view>
      </block>
      <block wx:else>
        <view class="btn" bindtap="onInvite" hover-class="btn-hover">生成邀请码</view>
      </block>
    </view>
    <view class="note-box tight">家人要先在小程序后台「成员管理 → 体验成员」里加上微信号，才能打开这个小程序。</view>
  </view>

  <view class="sec" wx:if="{{!fromCard}}">
    <view class="sec-head"><text class="eyebrow">{{me.memberCount > 1 ? '加入别人的家庭' : '家人已经在用？输邀请码加入'}}</text></view>
    <view class="rows">
      <view class="field">
        <text class="fl">邀请码</text>
        <input class="fi mono" value="{{joinCode}}" maxlength="6" placeholder="6 位" placeholder-class="ph" bindinput="onJoinCode" />
      </view>
      <view class="field last">
        <text class="fl">你的称呼</text>
        <input class="fi" value="{{joinName}}" placeholder="老婆 / 老公 / 名字" placeholder-class="ph" bindinput="onJoinName" />
      </view>
    </view>
    <view class="btn ghost mt" bindtap="onJoin" hover-class="btn-hover">加入</view>
    <view class="note-box tight">加入后看到的是对方家庭的账本。如果你自己已经录了资产，要先把它们标记为已结清。</view>
  </view>

  <!-- 本机隐私锁（面容 ID / 指纹） -->
  <view class="sec">
    <view class="sec-head"><text class="eyebrow">本机隐私保护</text></view>
    <view class="rows">
      <view class="field last">
        <view class="b" style="flex:1;padding-right:20rpx">
          <view style="font-size:28rpx;font-weight:500">{{bioLabel}}解锁</view>
          <view style="font-size:22rpx;color:var(--text-2);margin-top:6rpx">{{bioSupported ? '打开小程序时验证身份，借手机给孩子或他人时不露家底' : '当前设备暂不支持面容或指纹解锁'}}</view>
        </view>
        <switch checked="{{bioLock}}" disabled="{{!bioSupported}}" color="#B89A5E" bindchange="onToggleBio" />
      </view>
    </view>
  </view>

  <view class="sec" wx:if="{{!me.isOwner}}">
    <view class="link center danger" bindtap="onLeave">退出这个家庭</view>
  </view>
  <view style="height:120rpx"></view>
</view>
<view class="empty" wx:else>正在读取……</view>
