{
  "miniprogramRoot": "./",
  "cloudfunctionRoot": "cloudfunctions/",
  "compileType": "miniprogram",
  "appid": "REPLACE_WITH_YOUR_APPID",
  "projectname": "家底",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "nodeModules": false,
    "coverView": true,
    "packNpmManually": false,
    "ignoreDevUnusedFiles": false,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "libVersion": "3.5.5",
  "simulatorPluginLibVersion": {},
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "scripts"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": ".gitignore"
      }
    ],
    "include": []
  },
  "editorSetting": {}
}