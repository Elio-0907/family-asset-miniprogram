<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="path"
    class="tab {{selected === index ? 'on' : ''}}"
    data-index="{{index}}"
    data-path="{{item.path}}"
    bindtap="onTap">
    <view class="ic ic{{index}}"></view>
    <view class="lb">{{item.text}}</view>
  </view>
  <view class="tab add" bindtap="onAdd">
    <view class="ic icadd"></view>
    <view class="lb">记一笔</view>
  </view>
</view>
